<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="FileRadar.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="FrAccentColor">#0A6CFF</Color>
            <Color x:Key="FrBgColor">#F2F5FA</Color>
            <Color x:Key="FrPanelColor">#FFFFFF</Color>
            <Color x:Key="FrPanel2Color">#E8EEF7</Color>
            <Color x:Key="FrTextColor">#0F172A</Color>
            <Color x:Key="FrMutedColor">#5B6B7C</Color>
            <Color x:Key="FrBorderColor">#D5DEE9</Color>
            <Color x:Key="FrChipColor">#E3EFFF</Color>

            <SolidColorBrush x:Key="FrAccentBrush" Color="{StaticResource FrAccentColor}" />
            <SolidColorBrush x:Key="FrBgBrush" Color="{StaticResource FrBgColor}" />
            <SolidColorBrush x:Key="FrPanelBrush" Color="{StaticResource FrPanelColor}" />
            <SolidColorBrush x:Key="FrPanel2Brush" Color="{StaticResource FrPanel2Color}" />
            <SolidColorBrush x:Key="FrTextBrush" Color="{StaticResource FrTextColor}" />
            <SolidColorBrush x:Key="FrMutedBrush" Color="{StaticResource FrMutedColor}" />
            <SolidColorBrush x:Key="FrBorderBrush" Color="{StaticResource FrBorderColor}" />
            <SolidColorBrush x:Key="FrChipBrush" Color="{StaticResource FrChipColor}" />

            <x:Double x:Key="FrRadius">10</x:Double>
            <x:Double x:Key="FrTitleSize">22</x:Double>
            <x:Double x:Key="FrBodySize">14</x:Double>

            <Style x:Key="FrNavButton" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="FrPill" TargetType="Button">
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="CornerRadius" Value="999" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="FrCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Margin" Value="0,0,10,10" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Width" Value="148" />
                <Setter Property="Height" Value="168" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
