<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="FileRadar.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Apple-like Modern defaults: slate + blue -->
            <Color x:Key="FrAccentColor">#0A6BFF</Color>
            <Color x:Key="FrBgColor">#F5F5F7</Color>
            <Color x:Key="FrPanelColor">#FBFBFC</Color>
            <Color x:Key="FrPanel2Color">#EEF0F3</Color>
            <Color x:Key="FrTextColor">#1D1D1F</Color>
            <Color x:Key="FrMutedColor">#6E6E73</Color>
            <Color x:Key="FrBorderColor">#D2D2D7</Color>
            <Color x:Key="FrChipColor">#E8F0FF</Color>

            <SolidColorBrush x:Key="FrAccentBrush" Color="{StaticResource FrAccentColor}" />
            <SolidColorBrush x:Key="FrBgBrush" Color="{StaticResource FrBgColor}" />
            <SolidColorBrush x:Key="FrPanelBrush" Color="{StaticResource FrPanelColor}" />
            <SolidColorBrush x:Key="FrPanel2Brush" Color="{StaticResource FrPanel2Color}" />
            <SolidColorBrush x:Key="FrTextBrush" Color="{StaticResource FrTextColor}" />
            <SolidColorBrush x:Key="FrMutedBrush" Color="{StaticResource FrMutedColor}" />
            <SolidColorBrush x:Key="FrBorderBrush" Color="{StaticResource FrBorderColor}" />
            <SolidColorBrush x:Key="FrChipBrush" Color="{StaticResource FrChipColor}" />

            <x:Double x:Key="FrRadius">10</x:Double>
            <x:Double x:Key="FrTitleSize">22</x:Double>
            <x:Double x:Key="FrBodySize">13</x:Double>

            <Style x:Key="FrNavButton" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <!-- Quiet chrome chips — not loud pills -->
            <Style x:Key="FrPill" TargetType="Button">
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="FrCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Margin" Value="0,0,10,10" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Width" Value="148" />
                <Setter Property="Height" Value="168" />
            </Style>

            <Style x:Key="FrPrimaryButton" TargetType="Button" BasedOn="{StaticResource FrPill}">
                <Setter Property="Background" Value="{StaticResource FrAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
