<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="FileRadar.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Showcase Modern defaults (mockup) -->
            <Color x:Key="FrAccentColor">#007AFF</Color>
            <Color x:Key="FrBgColor">#E8E8ED</Color>
            <Color x:Key="FrPanelColor">#F5F5F7</Color>
            <Color x:Key="FrPanel2Color">#FFFFFF</Color>
            <Color x:Key="FrTextColor">#1D1D1F</Color>
            <Color x:Key="FrMutedColor">#6E6E73</Color>
            <Color x:Key="FrBorderColor">#D2D2D7</Color>
            <Color x:Key="FrChipColor">#E5F0FF</Color>
            <Color x:Key="FrSelectionColor">#007AFF22</Color>

            <SolidColorBrush x:Key="FrAccentBrush" Color="{StaticResource FrAccentColor}" />
            <SolidColorBrush x:Key="FrBgBrush" Color="{StaticResource FrBgColor}" />
            <SolidColorBrush x:Key="FrPanelBrush" Color="{StaticResource FrPanelColor}" />
            <SolidColorBrush x:Key="FrPanel2Brush" Color="{StaticResource FrPanel2Color}" />
            <SolidColorBrush x:Key="FrTextBrush" Color="{StaticResource FrTextColor}" />
            <SolidColorBrush x:Key="FrMutedBrush" Color="{StaticResource FrMutedColor}" />
            <SolidColorBrush x:Key="FrBorderBrush" Color="{StaticResource FrBorderColor}" />
            <SolidColorBrush x:Key="FrChipBrush" Color="{StaticResource FrChipColor}" />
            <SolidColorBrush x:Key="FrSelectionBrush" Color="{StaticResource FrSelectionColor}" />

            <x:Double x:Key="FrRadius">12</x:Double>

            <Style x:Key="FrNavButton" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="Margin" Value="4,1" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="FrQuietChip" TargetType="Button">
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <Style x:Key="FrGhostButton" TargetType="Button">
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- Quiet search — no loud red focus underline -->
            <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="#007AFF55" />
            <SolidColorBrush x:Key="AutoSuggestBoxBorderBrush" Color="#48484A" />
            <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#007AFF66" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#007AFF" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#0A84FF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
