<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="FileRadar.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- FileRadarChrome tokens (docs/fileradar-unified-look.md) — Dark mockup defaults -->
            <Color x:Key="FrAccentColor">#007AFF</Color>
            <Color x:Key="FrBgColor">#1C1C1E</Color>
            <Color x:Key="FrPanelColor">#2C2C2E</Color>
            <Color x:Key="FrPanel2Color">#3A3A3C</Color>
            <Color x:Key="FrTextColor">#F5F5F7</Color>
            <Color x:Key="FrMutedColor">#98989D</Color>
            <Color x:Key="FrBorderColor">#48484A</Color>
            <Color x:Key="FrChipColor">#1C3A5F</Color>
            <Color x:Key="FrSelectionColor">#007AFF14</Color>

            <SolidColorBrush x:Key="FrAccentBrush" Color="{StaticResource FrAccentColor}" />
            <SolidColorBrush x:Key="FrBgBrush" Color="{StaticResource FrBgColor}" />
            <SolidColorBrush x:Key="FrPanelBrush" Color="{StaticResource FrPanelColor}" />
            <SolidColorBrush x:Key="FrPanel2Brush" Color="{StaticResource FrPanel2Color}" />
            <SolidColorBrush x:Key="FrTextBrush" Color="{StaticResource FrTextColor}" />
            <SolidColorBrush x:Key="FrMutedBrush" Color="{StaticResource FrMutedColor}" />
            <SolidColorBrush x:Key="FrBorderBrush" Color="{StaticResource FrBorderColor}" />
            <SolidColorBrush x:Key="FrChipBrush" Color="{StaticResource FrChipColor}" />
            <SolidColorBrush x:Key="FrSelectionBrush" Color="{StaticResource FrSelectionColor}" />

            <x:Double x:Key="FrRadius">12</x:Double>
            <x:Double x:Key="FrRadiusControl">8</x:Double>

            <Style x:Key="FrNavButton" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="Margin" Value="4,1" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="FrQuietChip" TargetType="Button">
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Margin" Value="0,0,2,0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="MinWidth" Value="36" />
            </Style>

            <Style x:Key="FrGhostButton" TargetType="Button">
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="FrHudButton" TargetType="Button">
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Background" Value="#33FFFFFF" />
            </Style>

            <!-- Force FileRadarChrome accent — ignore machine system accent (often orange) -->
            <Color x:Key="SystemAccentColor">#007AFF</Color>
            <Color x:Key="SystemAccentColorLight1">#3395FF</Color>
            <Color x:Key="SystemAccentColorLight2">#66AFFF</Color>
            <Color x:Key="SystemAccentColorLight3">#99CAFF</Color>
            <Color x:Key="SystemAccentColorDark1">#0062CC</Color>
            <Color x:Key="SystemAccentColorDark2">#004999</Color>
            <Color x:Key="SystemAccentColorDark3">#003166</Color>
            <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#007AFF" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#007AFF" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#3395FF" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#66AFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#48484A" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#007AFF" />
            <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="#007AFF88" />
            <SolidColorBrush x:Key="AutoSuggestBoxBorderBrush" Color="#48484A" />
            <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#007AFF66" />
            <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#007AFF33" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#007AFF" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#007AFF" />
            <SolidColorBrush x:Key="TextControlButtonForeground" Color="#98989D" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
