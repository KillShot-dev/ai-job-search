<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="FileRadar.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    KeyDown="Page_KeyDown">

    <!-- Four chrome views: radarGlass | previewTheater | commandRail | workspaceTabs -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- D: Workspace tabs -->
        <Border Grid.Row="0" x:Name="WorkspaceTabsBar" Padding="10,6,12,0"
                Background="{StaticResource FrPanelBrush}" Visibility="Collapsed"
                BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="WorkspaceTabsPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom" />
                <Button Grid.Column="1" Content="+" Click="AddWorkspaceTab_Click" Style="{StaticResource FrQuietChip}"
                        ToolTipService.ToolTip="New workspace tab"
                        Background="Transparent" Foreground="{StaticResource FrMutedBrush}" />
            </Grid>
        </Border>

        <!-- Quiet toolbar — nav / chrome / view / sync / transfers -->
        <Border Grid.Row="1" x:Name="TopBar" Padding="12,6,12,6"
                Background="{StaticResource FrPanelBrush}"
                BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Image x:Name="BrandIcon" Width="22" Height="22" Stretch="Uniform" />
                    <TextBlock x:Name="BrandText" Text="FileRadar" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource FrTextBrush}" />
                </StackPanel>

                <AutoSuggestBox x:Name="SearchBox" Grid.Column="1"
                                PlaceholderText="Search"
                                QueryIcon="Find"
                                MaxWidth="420"
                                HorizontalAlignment="Stretch"
                                QuerySubmitted="SearchBox_QuerySubmitted"
                                TextChanged="SearchBox_TextChanged" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                    <Button x:Name="AppearanceBtn" Click="AppearanceBtn_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="Appearance  ·  Ctrl+Shift+A"
                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}">
                        <Image x:Name="AppearanceIconImg" Width="22" Height="22" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="ChromeBtn" Click="ChromeBtn_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="Chrome / Layout  ·  Ctrl+Shift+C"
                            Background="Transparent" Foreground="{StaticResource FrAccentBrush}">
                        <Image x:Name="ChromeIconImg" Width="22" Height="22" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="DualPaneBtn" Click="DualPaneBtn_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="Dual pane  ·  Ctrl+\ "
                            Background="Transparent" Foreground="{StaticResource FrAccentBrush}">
                        <Image x:Name="DualPaneIconImg" Width="22" Height="22" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="ViewModeBtn" Click="ViewModeBtn_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="List / grid  ·  Ctrl+1 / Ctrl+2"
                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}">
                        <Image x:Name="ViewModeIconImg" Width="22" Height="22" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="SyncBtn" Click="CompareSync_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="Compare / Sync between panes"
                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}">
                        <Image x:Name="SyncIconImg" Width="22" Height="22" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="InspectorBtn" Click="InspectorBtn_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="Toggle inspector  ·  Ctrl+Alt+I"
                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}">
                        <Image x:Name="InspectorIconImg" Width="22" Height="22" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="TransfersBtn" Click="TransfersBtn_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="Activities / Transfers  ·  Ctrl+Shift+T"
                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}">
                        <Image x:Name="TransfersIconImg" Width="22" Height="22" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="OverflowBtn" Click="OverflowBtn_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="More — rename, shortcuts, workspace, shelves"
                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}">
                        <Image x:Name="OverflowIconImg" Width="22" Height="22" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- B: Transfer top strip -->
        <Border Grid.Row="2" x:Name="TransferTopStrip" Padding="14,8" Visibility="Collapsed"
                Background="{StaticResource FrPanel2Brush}"
                BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TopStripHeadline" Text="Copying 1 item" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{StaticResource FrTextBrush}" />
                <ProgressBar x:Name="TopStripProgress" Grid.Column="1" Height="4" Minimum="0" Maximum="1" Value="0.33"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource FrAccentBrush}" Background="#48484A" />
                <TextBlock x:Name="TopStripPercent" Grid.Column="2" Text="33%" FontSize="11"
                           VerticalAlignment="Center" MinWidth="36" TextAlignment="Right"
                           Foreground="{StaticResource FrMutedBrush}" FontFamily="Consolas" />
                <Button x:Name="TopStripPauseBtn" Grid.Column="3" Content="Pause" Click="HudPause_Click"
                        Style="{StaticResource FrHudButton}" Foreground="{StaticResource FrTextBrush}" />
                <Button x:Name="TopStripCancelBtn" Grid.Column="4" Content="Cancel" Click="HudCancel_Click"
                        Style="{StaticResource FrHudButton}" Foreground="{StaticResource FrTextBrush}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CommandRailColumn" Width="0" />
                <ColumnDefinition x:Name="SidebarColumn" Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="0" />
                <ColumnDefinition x:Name="QueueColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- C: Vertical command rail -->
            <Border Grid.Column="0" x:Name="CommandRailBorder" Visibility="Collapsed"
                    Background="{StaticResource FrPanelBrush}"
                    BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel x:Name="CommandRailPanel" VerticalAlignment="Top" Padding="6,12" Spacing="8">
                    <Button Tag="Home" Click="CommandRail_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="Home" HorizontalAlignment="Center"
                            Background="Transparent" Foreground="{StaticResource FrAccentBrush}">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <Image x:Name="RailHomeImg" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" />
                            <TextBlock Text="Home" FontSize="9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="Search" Click="CommandRail_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="Search" HorizontalAlignment="Center"
                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <Image x:Name="RailSearchImg" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" />
                            <TextBlock Text="Search" FontSize="9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="Sync" Click="CommandRail_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="Sync" HorizontalAlignment="Center"
                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <Image x:Name="RailSyncImg" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" />
                            <TextBlock Text="Sync" FontSize="9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="Transfers" Click="CommandRail_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="Transfers" HorizontalAlignment="Center"
                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <Image x:Name="RailXferImg" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" />
                            <TextBlock Text="Xfer" FontSize="9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="Settings" Click="CommandRail_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="Appearance" HorizontalAlignment="Center"
                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <Image x:Name="RailPrefsImg" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" />
                            <TextBlock Text="Prefs" FontSize="9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Compact sidebar — favorites + places; tools secondary -->
            <Border Grid.Column="1" x:Name="SidebarBorder"
                    Background="{StaticResource FrPanelBrush}"
                    BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="0,0,1,0">
                <Grid Padding="8,10,8,10">
                    <!-- A: Radar watermark -->
                    <Canvas x:Name="RadarWatermark" IsHitTestVisible="False" Opacity="0.18" VerticalAlignment="Bottom"
                            HorizontalAlignment="Left" Width="220" Height="220" Margin="-40,0,0,-40">
                        <Ellipse Width="200" Height="200" Stroke="#66FFFFFF" StrokeThickness="1.5" Canvas.Left="10" Canvas.Top="10" />
                        <Ellipse Width="140" Height="140" Stroke="#55FFFFFF" StrokeThickness="1.2" Canvas.Left="40" Canvas.Top="40" />
                        <Ellipse Width="80" Height="80" Stroke="#44FFFFFF" StrokeThickness="1" Canvas.Left="70" Canvas.Top="70" />
                        <Ellipse Width="20" Height="20" Fill="#33FFFFFF" Canvas.Left="100" Canvas.Top="100" />
                    </Canvas>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,168">
                        <StackPanel x:Name="SidebarPanel" Spacing="1">
                            <Button x:Name="NavHome" Tag="Home" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image x:Name="NavHomeImg" Width="20" Height="20" Stretch="Uniform" />
                                    <TextBlock Text="Browser" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="FAVORITES" FontSize="10" CharacterSpacing="60" FontWeight="SemiBold"
                                       Foreground="{StaticResource FrMutedBrush}" Margin="10,14,6,4" />
                            <StackPanel x:Name="FavoritesPanel" Spacing="1" />

                            <TextBlock Text="PLACES" FontSize="10" CharacterSpacing="60" FontWeight="SemiBold"
                                       Foreground="{StaticResource FrMutedBrush}" Margin="10,14,6,4" />
                            <StackPanel x:Name="PlacesPanel" Spacing="1" />

                            <TextBlock Text="TOOLS" FontSize="10" CharacterSpacing="60" FontWeight="SemiBold"
                                       Foreground="{StaticResource FrMutedBrush}" Margin="10,14,6,4" />
                            <Button Tag="Shelves" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image x:Name="NavShelvesImg" Width="20" Height="20" Stretch="Uniform" />
                                    <TextBlock Text="Shelves" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Tag="Search" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image x:Name="NavSearchImg" Width="20" Height="20" Stretch="Uniform" />
                                    <TextBlock Text="Search" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Tag="Cleanup" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image x:Name="NavCleanupImg" Width="20" Height="20" Stretch="Uniform" />
                                    <TextBlock Text="Cleanup" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Tag="Duplicates" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image x:Name="NavDuplicatesImg" Width="20" Height="20" Stretch="Uniform" />
                                    <TextBlock Text="Duplicates" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Tag="Timeline" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image x:Name="NavTimelineImg" Width="20" Height="20" Stretch="Uniform" />
                                    <TextBlock Text="Timeline" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Tag="Workspaces" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image x:Name="NavWorkspacesImg" Width="20" Height="20" Stretch="Uniform" />
                                    <TextBlock Text="Workspaces" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Tag="RecycleBin" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image x:Name="NavRecycleImg" Width="20" Height="20" Stretch="Uniform" />
                                    <TextBlock Text="Recycle Bin" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Bottom" Spacing="6" Margin="2,0,2,0">
                        <Border x:Name="DropStackBorder" Padding="8,8" CornerRadius="8"
                                Background="{StaticResource FrPanel2Brush}"
                                BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="1"
                                AllowDrop="True"
                                DragOver="DropStack_DragOver"
                                Drop="DropStack_Drop"
                                PointerPressed="DropStack_PointerPressed">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Image x:Name="DropStackIconImg" Width="18" Height="18" Stretch="Uniform" />
                                        <TextBlock Text="Drop Stack" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource FrTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button x:Name="DropStackClearBtn" Content="Clear" HorizontalAlignment="Right"
                                            Padding="4,1" FontSize="10" Background="Transparent" BorderThickness="0"
                                            Foreground="{StaticResource FrMutedBrush}"
                                            Click="DropStackClear_Click" Visibility="Collapsed" />
                                </Grid>
                                <StackPanel x:Name="DropStackList" Spacing="2" />
                                <TextBlock x:Name="DropStackEmpty"
                                           Text="Hold files here."
                                           FontSize="10" TextWrapping="WrapWholeWords"
                                           Foreground="{StaticResource FrMutedBrush}" />
                                <Button x:Name="DropStackPlaceBtn" Content="Place stack…"
                                        Click="DropStackPlace_Click" FontSize="10" Padding="6,3"
                                        Style="{StaticResource FrGhostButton}"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource FrBorderBrush}"
                                        Foreground="{StaticResource FrTextBrush}"
                                        Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="DiskBarBorder" Padding="8,8" CornerRadius="8"
                                Background="{StaticResource FrPanel2Brush}"
                                BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="DiskNameText" Text="Local Disk" FontSize="11"
                                           Foreground="{StaticResource FrTextBrush}" />
                                <TextBlock x:Name="DiskFreeText" Text="…" FontSize="10"
                                           Foreground="{StaticResource FrMutedBrush}" TextWrapping="WrapWholeWords" />
                                <ProgressBar x:Name="DiskFreeBar" Height="3" Minimum="0" Maximum="1" Value="0.4"
                                             Foreground="{StaticResource FrAccentBrush}" Background="#48484A" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dual-pane browser + Activities HUD -->
            <Grid Grid.Column="2">
                <Grid x:Name="DetailRoot" Padding="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="ToolHeader" Grid.Row="0" Margin="16,12,16,0" Spacing="2" Visibility="Collapsed">
                        <TextBlock x:Name="BreadcrumbText" Text="›  Browser" FontSize="11"
                                   Foreground="{StaticResource FrMutedBrush}" />
                        <TextBlock x:Name="TitleText" Text="Browser" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource FrTextBrush}" />
                        <TextBlock x:Name="SubtitleText" Text="" FontSize="12"
                                   Foreground="{StaticResource FrMutedBrush}" Visibility="Collapsed" />
                        <StackPanel x:Name="BrowseActions" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0"
                                    Visibility="Collapsed">
                            <Button Content="Up" Click="UpBtn_Click" Style="{StaticResource FrGhostButton}"
                                    Background="{StaticResource FrPanelBrush}" BorderBrush="{StaticResource FrBorderBrush}"
                                    Foreground="{StaticResource FrTextBrush}" />
                            <Button Content="Trash" Click="TrashBtn_Click" Style="{StaticResource FrGhostButton}"
                                    Background="{StaticResource FrPanelBrush}" BorderBrush="{StaticResource FrBorderBrush}"
                                    Foreground="{StaticResource FrTextBrush}" />
                            <Button Content="Open" Click="OpenBtn_Click"
                                    Background="{StaticResource FrAccentBrush}" Foreground="White"
                                    BorderThickness="0" CornerRadius="8" Padding="12,6" FontSize="12" />
                            <Button Content="Rename…" Click="BatchRename_Click" Style="{StaticResource FrGhostButton}"
                                    Background="{StaticResource FrPanelBrush}" BorderBrush="{StaticResource FrBorderBrush}"
                                    Foreground="{StaticResource FrTextBrush}" />
                            <TextBlock x:Name="PathText" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{StaticResource FrMutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" x:Name="ContentSplit" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="LeftPaneCol" Width="*" />
                            <ColumnDefinition x:Name="DualDividerCol" Width="1" />
                            <ColumnDefinition x:Name="RightPaneCol" Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" x:Name="LeftPaneShell">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="LeftPathBar" Grid.Row="0" Padding="10,6"
                                    Background="{StaticResource FrPanelBrush}"
                                    BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="0,0,0,1"
                                    PointerPressed="LeftPane_Activate">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="‹" Click="LeftUp_Click" Padding="8,2" FontSize="14"
                                            Style="{StaticResource FrQuietChip}"
                                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}"
                                            ToolTipService.ToolTip="Up" />
                                    <Button Grid.Column="1" Content="⌂" Click="LeftHome_Click" Padding="8,2" FontSize="12"
                                            Style="{StaticResource FrQuietChip}"
                                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}"
                                            ToolTipService.ToolTip="User folder" />
                                    <Border x:Name="LeftPathPill" Grid.Column="2" CornerRadius="999" Padding="10,2"
                                            BorderThickness="1" BorderBrush="{StaticResource FrAccentBrush}"
                                            Background="{StaticResource FrPanel2Brush}">
                                        <TextBox x:Name="LeftPathBox" FontSize="12"
                                                 BorderThickness="0" Background="Transparent"
                                                 Foreground="{StaticResource FrTextBrush}"
                                                 KeyDown="LeftPathBox_KeyDown" />
                                    </Border>
                                    <TextBlock x:Name="LeftPaneHint" Grid.Column="3" Text="Left"
                                               FontSize="10" VerticalAlignment="Center"
                                               Foreground="{StaticResource FrAccentBrush}" />
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" x:Name="MainScroll" VerticalScrollBarVisibility="Auto"
                                          PointerPressed="LeftPane_Activate">
                                <Border x:Name="LeftPaneFrame" BorderThickness="0" CornerRadius="0" Padding="6,4">
                                    <StackPanel x:Name="MainContent" Spacing="8" />
                                </Border>
                            </ScrollViewer>
                        </Grid>

                        <Grid Grid.Column="1" x:Name="DualDividerHost" Width="1">
                            <Border x:Name="DualDivider" Width="1"
                                    Background="{StaticResource FrBorderBrush}"
                                    HorizontalAlignment="Center" />
                            <!-- C: Sync pill between panes -->
                            <Button x:Name="SyncPillBtn" Click="CopyLeftToRight_Click"
                                    Width="36" Height="36" CornerRadius="999" Padding="0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{StaticResource FrAccentBrush}" Foreground="White"
                                    BorderThickness="0" Visibility="Collapsed"
                                    ToolTipService.ToolTip="Copy selection → right pane">
                                <Image x:Name="SyncPillIconImg" Width="20" Height="20" Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <Grid Grid.Column="2" x:Name="RightPaneShell">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="RightPathBar" Grid.Row="0" Padding="10,6"
                                    Background="{StaticResource FrPanelBrush}"
                                    BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="0,0,0,1"
                                    PointerPressed="RightPane_Activate">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="‹" Click="RightUp_Click" Padding="8,2" FontSize="14"
                                            Style="{StaticResource FrQuietChip}"
                                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}"
                                            ToolTipService.ToolTip="Up" />
                                    <Button Grid.Column="1" Content="⌂" Click="RightHome_Click" Padding="8,2" FontSize="12"
                                            Style="{StaticResource FrQuietChip}"
                                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}"
                                            ToolTipService.ToolTip="Documents" />
                                    <Border x:Name="RightPathPill" Grid.Column="2" CornerRadius="999" Padding="10,2"
                                            BorderThickness="1" BorderBrush="{StaticResource FrBorderBrush}"
                                            Background="{StaticResource FrPanel2Brush}">
                                        <TextBox x:Name="RightPathBox" FontSize="12"
                                                 BorderThickness="0" Background="Transparent"
                                                 Foreground="{StaticResource FrTextBrush}"
                                                 KeyDown="RightPathBox_KeyDown" />
                                    </Border>
                                    <Button Grid.Column="3" Content="…" Click="ChooseRightFolder_Click" Padding="8,2"
                                            FontSize="12" Style="{StaticResource FrQuietChip}"
                                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}"
                                            ToolTipService.ToolTip="Choose right folder" />
                                    <TextBlock x:Name="RightPaneHint" Grid.Column="4" Text="Right"
                                               FontSize="10" VerticalAlignment="Center"
                                               Foreground="{StaticResource FrMutedBrush}" />
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" x:Name="RightScroll" VerticalScrollBarVisibility="Auto"
                                          PointerPressed="RightPane_Activate">
                                <Border x:Name="RightPaneFrame" BorderThickness="0" CornerRadius="0" Padding="6,4">
                                    <StackPanel x:Name="RightContent" Spacing="4" />
                                </Border>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <Border x:Name="DualPaneChrome" VerticalAlignment="Top" HorizontalAlignment="Center"
                        Margin="0,40,0,0" Padding="10,4" CornerRadius="8"
                        Background="#AA2C2C2E" Visibility="Collapsed"
                        BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Name="DualPaneActiveLabel" Text="Left pane active" FontSize="11"
                                   VerticalAlignment="Center" Foreground="{StaticResource FrMutedBrush}" />
                        <CheckBox x:Name="CopyOnDropCheck" Content="Copy on drop" FontSize="11"
                                  VerticalAlignment="Center"
                                  Checked="CopyOnDrop_Changed" Unchecked="CopyOnDrop_Changed"
                                  Foreground="{StaticResource FrMutedBrush}" />
                        <Button Content="Copy →" FontSize="11" Padding="10,3" Click="CopyLeftToRight_Click"
                                Style="{StaticResource FrGhostButton}"
                                Background="Transparent" BorderBrush="{StaticResource FrBorderBrush}"
                                Foreground="{StaticResource FrTextBrush}"
                                ToolTipService.ToolTip="Copy selection to right pane" />
                        <Button Content="← Copy" FontSize="11" Padding="10,3" Click="CopyRightToLeft_Click"
                                Style="{StaticResource FrGhostButton}"
                                Background="Transparent" BorderBrush="{StaticResource FrBorderBrush}"
                                Foreground="{StaticResource FrTextBrush}"
                                ToolTipService.ToolTip="Copy selection to left pane" />
                    </StackPanel>
                </Border>

                <!-- A: Docked / floating transfer HUD -->
                <Border x:Name="TransferHud" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Margin="16,0,16,14" MaxWidth="480" CornerRadius="999"
                        Padding="18,12" Visibility="Collapsed"
                        Background="#CC2C2C2E"
                        BorderBrush="#14FFFFFF" BorderThickness="1"
                        Translation="0,0,32">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="HudIconImg" Width="28" Height="28" Stretch="Uniform" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" MinWidth="180">
                            <TextBlock x:Name="HudHeadline" Text="Activities" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource FrTextBrush}" />
                            <ProgressBar x:Name="HudProgress" Height="4" Minimum="0" Maximum="1" Value="0"
                                         Foreground="{StaticResource FrAccentBrush}" Background="#48484A" />
                        </StackPanel>
                        <TextBlock x:Name="HudPercent" Grid.Column="2" Text="0%" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" MinWidth="36" TextAlignment="Right"
                                   Foreground="{StaticResource FrMutedBrush}" FontFamily="Consolas" />
                        <Button x:Name="HudPauseBtn" Grid.Column="3" Content="Pause" Click="HudPause_Click"
                                Style="{StaticResource FrHudButton}" Foreground="{StaticResource FrTextBrush}" />
                        <Button x:Name="HudCancelBtn" Grid.Column="4" Content="Cancel" Click="HudCancel_Click"
                                Style="{StaticResource FrHudButton}" Foreground="{StaticResource FrTextBrush}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- B: Optional inspector / Quick Look -->
            <Border x:Name="InspectorBorder" Grid.Column="3"
                    Background="{StaticResource FrPanelBrush}"
                    BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="1,0,0,0"
                    Padding="14,14" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer>
                        <StackPanel Spacing="12">
                            <Border x:Name="InspectorThumb" Height="160" CornerRadius="10"
                                    Background="{StaticResource FrPanel2Brush}"
                                    BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Image x:Name="InspectorImage" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <Image x:Name="InspectorGlyphImg" Width="72" Height="72" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <StackPanel Spacing="2">
                                <TextBlock x:Name="InspectorName" Text="Select a file"
                                           FontSize="14" FontWeight="SemiBold" TextWrapping="WrapWholeWords"
                                           Foreground="{StaticResource FrTextBrush}" />
                                <TextBlock x:Name="InspectorModified" Text="" FontSize="11"
                                           Foreground="{StaticResource FrMutedBrush}" />
                            </StackPanel>

                            <Expander Header="Info" IsExpanded="True" FontSize="12"
                                      Foreground="{StaticResource FrTextBrush}">
                                <StackPanel x:Name="InspectorMetaPanel" Spacing="6" Padding="0,6,0,0" />
                            </Expander>

                            <Expander Header="Tags" IsExpanded="False" FontSize="12"
                                      Foreground="{StaticResource FrTextBrush}">
                                <StackPanel Spacing="6" Padding="0,6,0,0">
                                    <StackPanel x:Name="InspectorTagsPanel" Orientation="Horizontal" Spacing="6" />
                                    <TextBlock x:Name="InspectorTagsEmpty" Text="No tags yet." FontSize="11"
                                               Foreground="{StaticResource FrMutedBrush}" Visibility="Collapsed" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="More" IsExpanded="False" FontSize="12"
                                      Foreground="{StaticResource FrTextBrush}">
                                <StackPanel x:Name="InspectorMorePanel" Spacing="6" Padding="0,6,0,0" />
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Spacing="6" Margin="0,10,0,0">
                        <Button x:Name="ShowInExplorerBtn" Click="ShowInExplorer_Click" HorizontalAlignment="Stretch"
                                Background="{StaticResource FrAccentBrush}" Foreground="White"
                                BorderThickness="0" CornerRadius="8" Padding="10,8" FontSize="12"
                                IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Image x:Name="ShowInExplorerIconImg" Width="18" Height="18" Stretch="Uniform" />
                                <TextBlock Text="Show in Explorer" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Content="Add to Drop Stack" Click="AddToDropStack_Click"
                                HorizontalAlignment="Stretch" Style="{StaticResource FrGhostButton}"
                                Background="Transparent" BorderBrush="{StaticResource FrBorderBrush}"
                                Foreground="{StaticResource FrMutedBrush}" FontSize="11" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- D: Queue drawer -->
            <Border x:Name="QueueDrawerBorder" Grid.Column="4" Visibility="Collapsed"
                    Background="{StaticResource FrPanelBrush}"
                    BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="1,0,0,0"
                    Padding="14,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image x:Name="QueueIconImg" Width="22" Height="22" Stretch="Uniform" />
                            <TextBlock Text="Queue" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource FrTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" Click="CloseQueue_Click"
                                Style="{StaticResource FrQuietChip}"
                                Background="Transparent" Foreground="{StaticResource FrMutedBrush}" />
                    </Grid>
                    <Border Grid.Row="1" Padding="12" CornerRadius="10" VerticalAlignment="Top"
                            Background="{StaticResource FrPanel2Brush}"
                            BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="QueueHeadline" Text="Idle" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource FrTextBrush}" />
                            <ProgressBar x:Name="QueueProgress" Height="6" Minimum="0" Maximum="1" Value="0"
                                         Foreground="{StaticResource FrAccentBrush}" Background="#48484A" />
                            <TextBlock x:Name="QueuePercent" Text="0%" FontSize="11"
                                       Foreground="{StaticResource FrMutedBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="QueuePauseBtn" Content="Pause" Click="HudPause_Click"
                                        Background="{StaticResource FrAccentBrush}" Foreground="White"
                                        BorderThickness="0" CornerRadius="8" Padding="12,6" FontSize="12" />
                                <Button Content="Cancel" Click="HudCancel_Click" Style="{StaticResource FrGhostButton}"
                                        Background="Transparent" BorderBrush="{StaticResource FrBorderBrush}"
                                        Foreground="{StaticResource FrTextBrush}" Padding="12,6" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- C: Keyboard legend -->
        <Border Grid.Row="4" x:Name="KeyboardLegendBar" Padding="14,8" Visibility="Collapsed"
                Background="{StaticResource FrPanelBrush}"
                BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                <TextBlock Text="F5 Refresh" FontSize="11" Foreground="{StaticResource FrMutedBrush}" />
                <TextBlock Text="|" FontSize="11" Foreground="{StaticResource FrBorderBrush}" />
                <TextBlock Text="F8 Delete" FontSize="11" Foreground="{StaticResource FrMutedBrush}" />
                <TextBlock Text="|" FontSize="11" Foreground="{StaticResource FrBorderBrush}" />
                <TextBlock Text="F9 New Folder" FontSize="11" Foreground="{StaticResource FrMutedBrush}" />
                <TextBlock Text="|" FontSize="11" Foreground="{StaticResource FrBorderBrush}" />
                <TextBlock Text="Ctrl+, Preferences" FontSize="11" Foreground="{StaticResource FrMutedBrush}" />
                <TextBlock Text="|" FontSize="11" Foreground="{StaticResource FrBorderBrush}" />
                <TextBlock Text="Ctrl+Shift+C Chrome" FontSize="11" Foreground="{StaticResource FrAccentBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
