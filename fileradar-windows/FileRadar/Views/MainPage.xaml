<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="FileRadar.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    KeyDown="Page_KeyDown">

    <!-- ForkLift-first: compact sidebar | dual panes + path bars | optional inspector + Activities HUD -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Quiet toolbar — nav / view / sync / transfers -->
        <Border Grid.Row="0" x:Name="TopBar" Padding="12,6,12,6"
                Background="{StaticResource FrPanelBrush}"
                BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE71B;" FontSize="15" Foreground="{StaticResource FrAccentBrush}" />
                    <TextBlock Text="FileRadar" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource FrTextBrush}" />
                </StackPanel>

                <AutoSuggestBox x:Name="SearchBox" Grid.Column="1"
                                PlaceholderText="Search"
                                QueryIcon="Find"
                                MaxWidth="420"
                                HorizontalAlignment="Stretch"
                                QuerySubmitted="SearchBox_QuerySubmitted"
                                TextChanged="SearchBox_TextChanged" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                    <Button x:Name="AppearanceBtn" Click="AppearanceBtn_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="Appearance  ·  Ctrl+Shift+A"
                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}">
                        <FontIcon x:Name="AppearanceIcon" Glyph="&#xE708;" FontSize="14" />
                    </Button>
                    <Button x:Name="DualPaneBtn" Click="DualPaneBtn_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="Dual pane  ·  Ctrl+\ "
                            Background="Transparent" Foreground="{StaticResource FrAccentBrush}">
                        <FontIcon x:Name="DualPaneIcon" Glyph="&#xE7C4;" FontSize="14" />
                    </Button>
                    <Button x:Name="ViewModeBtn" Click="ViewModeBtn_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="List / grid  ·  Ctrl+1 / Ctrl+2"
                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}">
                        <FontIcon Glyph="&#xE8A9;" FontSize="14" />
                    </Button>
                    <Button x:Name="SyncBtn" Click="CompareSync_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="Compare / Sync between panes"
                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}">
                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                    </Button>
                    <Button x:Name="InspectorBtn" Click="InspectorBtn_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="Toggle inspector  ·  Ctrl+Alt+I"
                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}">
                        <FontIcon Glyph="&#xE8A1;" FontSize="14" />
                    </Button>
                    <Button x:Name="TransfersBtn" Click="TransfersBtn_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="Activities / Transfers  ·  Ctrl+Shift+T"
                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}">
                        <FontIcon Glyph="&#xE8AB;" FontSize="14" />
                    </Button>
                    <Button x:Name="OverflowBtn" Click="OverflowBtn_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="More — rename, shortcuts, workspace, shelves"
                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Compact sidebar — favorites + places; tools secondary -->
            <Border Grid.Column="0" x:Name="SidebarBorder"
                    Background="{StaticResource FrPanelBrush}"
                    BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="0,0,1,0">
                <Grid Padding="8,10,8,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,168">
                        <StackPanel x:Name="SidebarPanel" Spacing="1">
                            <Button x:Name="NavHome" Tag="Home" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                                    <TextBlock Text="Browser" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="FAVORITES" FontSize="10" CharacterSpacing="60" FontWeight="SemiBold"
                                       Foreground="{StaticResource FrMutedBrush}" Margin="10,14,6,4" />
                            <StackPanel x:Name="FavoritesPanel" Spacing="1" />

                            <TextBlock Text="PLACES" FontSize="10" CharacterSpacing="60" FontWeight="SemiBold"
                                       Foreground="{StaticResource FrMutedBrush}" Margin="10,14,6,4" />
                            <StackPanel x:Name="PlacesPanel" Spacing="1" />

                            <TextBlock Text="TOOLS" FontSize="10" CharacterSpacing="60" FontWeight="SemiBold"
                                       Foreground="{StaticResource FrMutedBrush}" Margin="10,14,6,4" />
                            <Button Tag="Shelves" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="13" />
                                    <TextBlock Text="Shelves" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Tag="Search" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="13" />
                                    <TextBlock Text="Search" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Tag="Cleanup" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE894;" FontSize="13" />
                                    <TextBlock Text="Cleanup" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Tag="Duplicates" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                    <TextBlock Text="Duplicates" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Tag="Timeline" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE787;" FontSize="13" />
                                    <TextBlock Text="Timeline" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Tag="Workspaces" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A9;" FontSize="13" />
                                    <TextBlock Text="Workspaces" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Tag="RecycleBin" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                    <TextBlock Text="Recycle Bin" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Bottom" Spacing="6" Margin="2,0,2,0">
                        <Border x:Name="DropStackBorder" Padding="8,8" CornerRadius="8"
                                Background="{StaticResource FrPanel2Brush}"
                                BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="1"
                                AllowDrop="True"
                                DragOver="DropStack_DragOver"
                                Drop="DropStack_Drop"
                                PointerPressed="DropStack_PointerPressed">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74C;" FontSize="11" Foreground="{StaticResource FrMutedBrush}" />
                                        <TextBlock Text="Drop Stack" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource FrTextBrush}" />
                                    </StackPanel>
                                    <Button x:Name="DropStackClearBtn" Content="Clear" HorizontalAlignment="Right"
                                            Padding="4,1" FontSize="10" Background="Transparent" BorderThickness="0"
                                            Foreground="{StaticResource FrMutedBrush}"
                                            Click="DropStackClear_Click" Visibility="Collapsed" />
                                </Grid>
                                <StackPanel x:Name="DropStackList" Spacing="2" />
                                <TextBlock x:Name="DropStackEmpty"
                                           Text="Hold files here."
                                           FontSize="10" TextWrapping="WrapWholeWords"
                                           Foreground="{StaticResource FrMutedBrush}" />
                                <Button x:Name="DropStackPlaceBtn" Content="Place stack…"
                                        Click="DropStackPlace_Click" FontSize="10" Padding="6,3"
                                        Style="{StaticResource FrGhostButton}"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource FrBorderBrush}"
                                        Foreground="{StaticResource FrTextBrush}"
                                        Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="DiskBarBorder" Padding="8,8" CornerRadius="8"
                                Background="{StaticResource FrPanel2Brush}"
                                BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="DiskNameText" Text="Local Disk" FontSize="11"
                                           Foreground="{StaticResource FrTextBrush}" />
                                <TextBlock x:Name="DiskFreeText" Text="…" FontSize="10"
                                           Foreground="{StaticResource FrMutedBrush}" TextWrapping="WrapWholeWords" />
                                <ProgressBar x:Name="DiskFreeBar" Height="3" Minimum="0" Maximum="1" Value="0.4"
                                             Foreground="{StaticResource FrAccentBrush}" Background="#48484A" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dual-pane browser + Activities HUD -->
            <Grid Grid.Column="1">
                <Grid x:Name="DetailRoot" Padding="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Single-pane chrome for tools / shelves (hidden in dual browser) -->
                    <StackPanel x:Name="ToolHeader" Grid.Row="0" Margin="16,12,16,0" Spacing="2" Visibility="Collapsed">
                        <TextBlock x:Name="BreadcrumbText" Text="›  Browser" FontSize="11"
                                   Foreground="{StaticResource FrMutedBrush}" />
                        <TextBlock x:Name="TitleText" Text="Browser" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource FrTextBrush}" />
                        <TextBlock x:Name="SubtitleText" Text="" FontSize="12"
                                   Foreground="{StaticResource FrMutedBrush}" Visibility="Collapsed" />
                        <StackPanel x:Name="BrowseActions" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0"
                                    Visibility="Collapsed">
                            <Button Content="Up" Click="UpBtn_Click" Style="{StaticResource FrGhostButton}"
                                    Background="{StaticResource FrPanelBrush}" BorderBrush="{StaticResource FrBorderBrush}"
                                    Foreground="{StaticResource FrTextBrush}" />
                            <Button Content="Trash" Click="TrashBtn_Click" Style="{StaticResource FrGhostButton}"
                                    Background="{StaticResource FrPanelBrush}" BorderBrush="{StaticResource FrBorderBrush}"
                                    Foreground="{StaticResource FrTextBrush}" />
                            <Button Content="Open" Click="OpenBtn_Click"
                                    Background="{StaticResource FrAccentBrush}" Foreground="White"
                                    BorderThickness="0" CornerRadius="8" Padding="12,6" FontSize="12" />
                            <Button Content="Rename…" Click="BatchRename_Click" Style="{StaticResource FrGhostButton}"
                                    Background="{StaticResource FrPanelBrush}" BorderBrush="{StaticResource FrBorderBrush}"
                                    Foreground="{StaticResource FrTextBrush}" />
                            <TextBlock x:Name="PathText" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{StaticResource FrMutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" x:Name="ContentSplit" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="LeftPaneCol" Width="*" />
                            <ColumnDefinition x:Name="DualDividerCol" Width="1" />
                            <ColumnDefinition x:Name="RightPaneCol" Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left pane -->
                        <Grid Grid.Column="0" x:Name="LeftPaneShell">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="LeftPathBar" Grid.Row="0" Padding="10,6"
                                    Background="{StaticResource FrPanelBrush}"
                                    BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="0,0,0,1"
                                    PointerPressed="LeftPane_Activate">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="‹" Click="LeftUp_Click" Padding="8,2" FontSize="14"
                                            Style="{StaticResource FrQuietChip}"
                                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}"
                                            ToolTipService.ToolTip="Up" />
                                    <Button Grid.Column="1" Content="⌂" Click="LeftHome_Click" Padding="8,2" FontSize="12"
                                            Style="{StaticResource FrQuietChip}"
                                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}"
                                            ToolTipService.ToolTip="User folder" />
                                    <TextBox x:Name="LeftPathBox" Grid.Column="2" FontSize="12"
                                             BorderThickness="0" Background="Transparent"
                                             Foreground="{StaticResource FrTextBrush}"
                                             KeyDown="LeftPathBox_KeyDown" />
                                    <TextBlock x:Name="LeftPaneHint" Grid.Column="3" Text="Left"
                                               FontSize="10" VerticalAlignment="Center"
                                               Foreground="{StaticResource FrAccentBrush}" />
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" x:Name="MainScroll" VerticalScrollBarVisibility="Auto"
                                          PointerPressed="LeftPane_Activate">
                                <Border x:Name="LeftPaneFrame" BorderThickness="0" CornerRadius="0" Padding="6,4">
                                    <StackPanel x:Name="MainContent" Spacing="8" />
                                </Border>
                            </ScrollViewer>
                        </Grid>

                        <Border Grid.Column="1" x:Name="DualDivider" Width="1"
                                Background="{StaticResource FrBorderBrush}" />

                        <!-- Right pane -->
                        <Grid Grid.Column="2" x:Name="RightPaneShell">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="RightPathBar" Grid.Row="0" Padding="10,6"
                                    Background="{StaticResource FrPanelBrush}"
                                    BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="0,0,0,1"
                                    PointerPressed="RightPane_Activate">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="‹" Click="RightUp_Click" Padding="8,2" FontSize="14"
                                            Style="{StaticResource FrQuietChip}"
                                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}"
                                            ToolTipService.ToolTip="Up" />
                                    <Button Grid.Column="1" Content="⌂" Click="RightHome_Click" Padding="8,2" FontSize="12"
                                            Style="{StaticResource FrQuietChip}"
                                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}"
                                            ToolTipService.ToolTip="Documents" />
                                    <TextBox x:Name="RightPathBox" Grid.Column="2" FontSize="12"
                                             BorderThickness="0" Background="Transparent"
                                             Foreground="{StaticResource FrTextBrush}"
                                             KeyDown="RightPathBox_KeyDown" />
                                    <Button Grid.Column="3" Content="…" Click="ChooseRightFolder_Click" Padding="8,2"
                                            FontSize="12" Style="{StaticResource FrQuietChip}"
                                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}"
                                            ToolTipService.ToolTip="Choose right folder" />
                                    <TextBlock x:Name="RightPaneHint" Grid.Column="4" Text="Right"
                                               FontSize="10" VerticalAlignment="Center"
                                               Foreground="{StaticResource FrMutedBrush}" />
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" x:Name="RightScroll" VerticalScrollBarVisibility="Auto"
                                          PointerPressed="RightPane_Activate">
                                <Border x:Name="RightPaneFrame" BorderThickness="0" CornerRadius="0" Padding="6,4">
                                    <StackPanel x:Name="RightContent" Spacing="4" />
                                </Border>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Dual-pane ops strip -->
                <Border x:Name="DualPaneChrome" VerticalAlignment="Top" HorizontalAlignment="Center"
                        Margin="0,40,0,0" Padding="10,4" CornerRadius="8"
                        Background="#AA2C2C2E" Visibility="Collapsed"
                        BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Name="DualPaneActiveLabel" Text="Left pane active" FontSize="11"
                                   VerticalAlignment="Center" Foreground="{StaticResource FrMutedBrush}" />
                        <CheckBox x:Name="CopyOnDropCheck" Content="Copy on drop" FontSize="11"
                                  VerticalAlignment="Center"
                                  Checked="CopyOnDrop_Changed" Unchecked="CopyOnDrop_Changed"
                                  Foreground="{StaticResource FrMutedBrush}" />
                        <Button Content="Copy →" FontSize="11" Padding="10,3" Click="CopyLeftToRight_Click"
                                Style="{StaticResource FrGhostButton}"
                                Background="Transparent" BorderBrush="{StaticResource FrBorderBrush}"
                                Foreground="{StaticResource FrTextBrush}"
                                ToolTipService.ToolTip="Copy selection to right pane" />
                        <Button Content="← Copy" FontSize="11" Padding="10,3" Click="CopyRightToLeft_Click"
                                Style="{StaticResource FrGhostButton}"
                                Background="Transparent" BorderBrush="{StaticResource FrBorderBrush}"
                                Foreground="{StaticResource FrTextBrush}"
                                ToolTipService.ToolTip="Copy selection to left pane" />
                    </StackPanel>
                </Border>

                <!-- Activities / Transfer HUD (ForkLift signature) -->
                <Border x:Name="TransferHud" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Margin="16,0,16,14" MaxWidth="480" CornerRadius="999"
                        Padding="18,12" Visibility="Collapsed"
                        Background="#CC2C2C2E"
                        BorderBrush="#14FFFFFF" BorderThickness="1"
                        Translation="0,0,32">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="HudIcon" Glyph="&#xE8C8;" FontSize="18"
                                  Foreground="{StaticResource FrAccentBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" MinWidth="180">
                            <TextBlock x:Name="HudHeadline" Text="Activities" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource FrTextBrush}" />
                            <ProgressBar x:Name="HudProgress" Height="4" Minimum="0" Maximum="1" Value="0"
                                         Foreground="{StaticResource FrAccentBrush}" Background="#48484A" />
                        </StackPanel>
                        <TextBlock x:Name="HudPercent" Grid.Column="2" Text="0%" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" MinWidth="36" TextAlignment="Right"
                                   Foreground="{StaticResource FrMutedBrush}" FontFamily="Consolas" />
                        <Button x:Name="HudPauseBtn" Grid.Column="3" Content="Pause" Click="HudPause_Click"
                                Style="{StaticResource FrHudButton}" Foreground="{StaticResource FrTextBrush}" />
                        <Button x:Name="HudCancelBtn" Grid.Column="4" Content="Cancel" Click="HudCancel_Click"
                                Style="{StaticResource FrHudButton}" Foreground="{StaticResource FrTextBrush}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Optional inspector -->
            <Border x:Name="InspectorBorder" Grid.Column="2"
                    Background="{StaticResource FrPanelBrush}"
                    BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="1,0,0,0"
                    Padding="14,14" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer>
                        <StackPanel Spacing="12">
                            <Border x:Name="InspectorThumb" Height="160" CornerRadius="10"
                                    Background="{StaticResource FrPanel2Brush}"
                                    BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Image x:Name="InspectorImage" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <FontIcon x:Name="InspectorGlyph" Glyph="&#xE8A5;" FontSize="36"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{StaticResource FrMutedBrush}" />
                                </Grid>
                            </Border>

                            <StackPanel Spacing="2">
                                <TextBlock x:Name="InspectorName" Text="Select a file"
                                           FontSize="14" FontWeight="SemiBold" TextWrapping="WrapWholeWords"
                                           Foreground="{StaticResource FrTextBrush}" />
                                <TextBlock x:Name="InspectorModified" Text="" FontSize="11"
                                           Foreground="{StaticResource FrMutedBrush}" />
                            </StackPanel>

                            <Expander Header="Info" IsExpanded="True" FontSize="12"
                                      Foreground="{StaticResource FrTextBrush}">
                                <StackPanel x:Name="InspectorMetaPanel" Spacing="6" Padding="0,6,0,0" />
                            </Expander>

                            <Expander Header="Tags" IsExpanded="False" FontSize="12"
                                      Foreground="{StaticResource FrTextBrush}">
                                <StackPanel Spacing="6" Padding="0,6,0,0">
                                    <StackPanel x:Name="InspectorTagsPanel" Orientation="Horizontal" Spacing="6" />
                                    <TextBlock x:Name="InspectorTagsEmpty" Text="No tags yet." FontSize="11"
                                               Foreground="{StaticResource FrMutedBrush}" Visibility="Collapsed" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="More" IsExpanded="False" FontSize="12"
                                      Foreground="{StaticResource FrTextBrush}">
                                <StackPanel x:Name="InspectorMorePanel" Spacing="6" Padding="0,6,0,0" />
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Spacing="6" Margin="0,10,0,0">
                        <Button x:Name="ShowInExplorerBtn" Click="ShowInExplorer_Click" HorizontalAlignment="Stretch"
                                Background="{StaticResource FrAccentBrush}" Foreground="White"
                                BorderThickness="0" CornerRadius="8" Padding="10,8" FontSize="12"
                                IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                                <TextBlock Text="Show in Explorer" />
                            </StackPanel>
                        </Button>
                        <Button Content="Add to Drop Stack" Click="AddToDropStack_Click"
                                HorizontalAlignment="Stretch" Style="{StaticResource FrGhostButton}"
                                Background="Transparent" BorderBrush="{StaticResource FrBorderBrush}"
                                Foreground="{StaticResource FrMutedBrush}" FontSize="11" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
