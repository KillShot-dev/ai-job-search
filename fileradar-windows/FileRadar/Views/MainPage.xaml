<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="FileRadar.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    KeyDown="Page_KeyDown">

    <!-- Unified Showcase: sidebar | Home shelves+recents | inspector + Transfer HUD -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Quiet toolbar ≤6 primary icons (unified-look §2.3) -->
        <Border Grid.Row="0" x:Name="TopBar" Padding="14,8,14,8"
                Background="{StaticResource FrPanelBrush}"
                BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE71B;" FontSize="16" Foreground="{StaticResource FrAccentBrush}" />
                    <TextBlock Text="FileRadar" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource FrTextBrush}" />
                </StackPanel>

                <AutoSuggestBox x:Name="SearchBox" Grid.Column="1"
                                PlaceholderText="Search"
                                QueryIcon="Find"
                                MaxWidth="520"
                                HorizontalAlignment="Stretch"
                                QuerySubmitted="SearchBox_QuerySubmitted"
                                TextChanged="SearchBox_TextChanged" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                    <Button x:Name="AppearanceBtn" Click="AppearanceBtn_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="Appearance  ·  Ctrl+Shift+A"
                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}">
                        <FontIcon x:Name="AppearanceIcon" Glyph="&#xE708;" FontSize="14" />
                    </Button>
                    <Button x:Name="DualPaneBtn" Click="DualPaneBtn_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="Dual pane (optional)  ·  Ctrl+\ "
                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}">
                        <FontIcon x:Name="DualPaneIcon" Glyph="&#xE7C4;" FontSize="14" />
                    </Button>
                    <Button x:Name="ViewModeBtn" Click="ViewModeBtn_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="Recents grid / list  ·  Ctrl+1 / Ctrl+2"
                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}">
                        <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                    </Button>
                    <Button x:Name="InspectorBtn" Click="InspectorBtn_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="Toggle inspector  ·  Ctrl+Alt+I"
                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}">
                        <FontIcon Glyph="&#xE8A1;" FontSize="14" />
                    </Button>
                    <Button x:Name="TransfersBtn" Click="TransfersBtn_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="Transfers  ·  Ctrl+Shift+T"
                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}">
                        <FontIcon Glyph="&#xE8AB;" FontSize="14" />
                    </Button>
                    <Button x:Name="OverflowBtn" Click="OverflowBtn_Click" Style="{StaticResource FrQuietChip}"
                            ToolTipService.ToolTip="More — rename, sync, shortcuts, workspace"
                            Background="Transparent" Foreground="{StaticResource FrMutedBrush}">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" x:Name="SidebarBorder"
                    Background="{StaticResource FrPanelBrush}"
                    BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="0,0,1,0">
                <Grid Padding="10,12,10,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,200">
                        <StackPanel x:Name="SidebarPanel" Spacing="2">
                            <Button x:Name="NavHome" Tag="Home" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE80F;" FontSize="14" />
                                    <TextBlock Text="Home" />
                                </StackPanel>
                            </Button>
                            <Button Tag="Search" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE721;" FontSize="14" />
                                    <TextBlock Text="Search" />
                                </StackPanel>
                            </Button>
                            <Button Tag="Cleanup" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE894;" FontSize="14" />
                                    <TextBlock Text="Cleanup" />
                                </StackPanel>
                            </Button>
                            <Button Tag="Duplicates" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    <TextBlock Text="Duplicates" />
                                </StackPanel>
                            </Button>
                            <Button Tag="Timeline" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE787;" FontSize="14" />
                                    <TextBlock Text="Timeline" />
                                </StackPanel>
                            </Button>
                            <Button Tag="Workspaces" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8A9;" FontSize="14" />
                                    <TextBlock Text="Workspaces" />
                                </StackPanel>
                            </Button>
                            <Button Tag="RecycleBin" Click="Nav_Click" Style="{StaticResource FrNavButton}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock Text="Recycle Bin" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="FAVORITES" FontSize="11" CharacterSpacing="60" FontWeight="SemiBold"
                                       Foreground="{StaticResource FrMutedBrush}" Margin="12,18,8,6" />
                            <StackPanel x:Name="FavoritesPanel" Spacing="2" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Drop Stack + disk bar pinned (unified-look §2.5) -->
                    <StackPanel VerticalAlignment="Bottom" Spacing="8" Margin="4,0,4,0">
                        <Border x:Name="DropStackBorder" Padding="10,10" CornerRadius="10"
                                Background="{StaticResource FrPanel2Brush}"
                                BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="1"
                                AllowDrop="True"
                                DragOver="DropStack_DragOver"
                                Drop="DropStack_Drop"
                                PointerPressed="DropStack_PointerPressed">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74C;" FontSize="12" Foreground="{StaticResource FrMutedBrush}" />
                                        <TextBlock Text="Drop Stack" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource FrTextBrush}" />
                                    </StackPanel>
                                    <Button x:Name="DropStackClearBtn" Content="Clear" HorizontalAlignment="Right"
                                            Padding="6,2" FontSize="11" Background="Transparent" BorderThickness="0"
                                            Foreground="{StaticResource FrMutedBrush}"
                                            Click="DropStackClear_Click" Visibility="Collapsed" />
                                </Grid>
                                <StackPanel x:Name="DropStackList" Spacing="4" />
                                <TextBlock x:Name="DropStackEmpty"
                                           Text="Drag files here to hold them."
                                           FontSize="11" TextWrapping="WrapWholeWords"
                                           Foreground="{StaticResource FrMutedBrush}" />
                                <Button x:Name="DropStackPlaceBtn" Content="Place stack…"
                                        Click="DropStackPlace_Click" FontSize="11" Padding="8,4"
                                        Style="{StaticResource FrGhostButton}"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource FrBorderBrush}"
                                        Foreground="{StaticResource FrTextBrush}"
                                        Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="DiskBarBorder" Padding="10,10" CornerRadius="10"
                                Background="{StaticResource FrPanel2Brush}"
                                BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="12" Foreground="{StaticResource FrMutedBrush}" />
                                    <TextBlock x:Name="DiskNameText" Text="Local Disk" FontSize="12"
                                               Foreground="{StaticResource FrTextBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="DiskFreeText" Text="…" FontSize="11"
                                           Foreground="{StaticResource FrMutedBrush}" TextWrapping="WrapWholeWords" />
                                <ProgressBar x:Name="DiskFreeBar" Height="4" Minimum="0" Maximum="1" Value="0.4"
                                             Foreground="{StaticResource FrAccentBrush}" Background="#48484A" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main content + dual-pane + HUD overlay -->
            <Grid Grid.Column="1">
                <Grid x:Name="DetailRoot" Padding="20,18,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14" Spacing="2">
                        <TextBlock x:Name="BreadcrumbText" Text="›  Home" FontSize="12"
                                   Foreground="{StaticResource FrMutedBrush}" Margin="0,0,0,4" />
                        <TextBlock x:Name="TitleText" Text="Home" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource FrTextBrush}" />
                        <TextBlock x:Name="SubtitleText" Text="" FontSize="12"
                                   Foreground="{StaticResource FrMutedBrush}" Visibility="Collapsed" />
                        <StackPanel x:Name="BrowseActions" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0"
                                    Visibility="Collapsed">
                            <Button Content="Up" Click="UpBtn_Click" Style="{StaticResource FrGhostButton}"
                                    Background="{StaticResource FrPanelBrush}" BorderBrush="{StaticResource FrBorderBrush}"
                                    Foreground="{StaticResource FrTextBrush}"
                                    ToolTipService.ToolTip="Up  ·  Alt+↑" />
                            <Button Content="Trash" Click="TrashBtn_Click" Style="{StaticResource FrGhostButton}"
                                    Background="{StaticResource FrPanelBrush}" BorderBrush="{StaticResource FrBorderBrush}"
                                    Foreground="{StaticResource FrTextBrush}"
                                    ToolTipService.ToolTip="Trash  ·  Delete" />
                            <Button Content="Open" Click="OpenBtn_Click"
                                    Background="{StaticResource FrAccentBrush}" Foreground="White"
                                    BorderThickness="0" CornerRadius="8" Padding="12,6" FontSize="12"
                                    ToolTipService.ToolTip="Open  ·  Enter" />
                            <Button Content="Rename…" Click="BatchRename_Click" Style="{StaticResource FrGhostButton}"
                                    Background="{StaticResource FrPanelBrush}" BorderBrush="{StaticResource FrBorderBrush}"
                                    Foreground="{StaticResource FrTextBrush}"
                                    ToolTipService.ToolTip="Batch rename  ·  Ctrl+Shift+R" />
                            <TextBlock x:Name="PathText" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource FrMutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Dual-pane quiet chrome (hidden unless enabled) -->
                    <Border x:Name="DualPaneChrome" Grid.Row="1" Margin="0,0,0,8" Padding="12,6"
                            Background="#08FFFFFF" Visibility="Collapsed"
                            BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DualPaneActiveLabel" Text="Left pane active" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{StaticResource FrMutedBrush}" />
                            <CheckBox x:Name="CopyOnDropCheck" Grid.Column="1" Content="Drop copies"
                                      FontSize="11" VerticalAlignment="Center"
                                      Checked="CopyOnDrop_Changed" Unchecked="CopyOnDrop_Changed"
                                      Foreground="{StaticResource FrMutedBrush}" />
                            <Button Grid.Column="2" Content="Choose right folder…" FontSize="11"
                                    Padding="10,4" Click="ChooseRightFolder_Click"
                                    Style="{StaticResource FrGhostButton}"
                                    Background="Transparent" BorderBrush="{StaticResource FrBorderBrush}"
                                    Foreground="{StaticResource FrTextBrush}" />
                            <Button Grid.Column="3" Content="Compare / Sync…" FontSize="11"
                                    Padding="10,4" Click="CompareSync_Click"
                                    Style="{StaticResource FrGhostButton}"
                                    Background="Transparent" BorderBrush="{StaticResource FrBorderBrush}"
                                    Foreground="{StaticResource FrMutedBrush}"
                                    ToolTipService.ToolTip="Folder compare entry (preview)" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" x:Name="ContentSplit">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="LeftPaneCol" Width="*" />
                            <ColumnDefinition x:Name="DualDividerCol" Width="0" />
                            <ColumnDefinition x:Name="RightPaneCol" Width="0" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" x:Name="MainScroll" VerticalScrollBarVisibility="Auto"
                                      BorderBrush="{StaticResource FrAccentBrush}" BorderThickness="0">
                            <Border x:Name="LeftPaneFrame" BorderThickness="0" CornerRadius="8" Padding="2">
                                <StackPanel x:Name="MainContent" Spacing="28" />
                            </Border>
                        </ScrollViewer>

                        <Border Grid.Column="1" x:Name="DualDivider" Width="1"
                                Background="{StaticResource FrBorderBrush}" Visibility="Collapsed" />

                        <ScrollViewer Grid.Column="2" x:Name="RightScroll" VerticalScrollBarVisibility="Auto"
                                      Visibility="Collapsed">
                            <Border x:Name="RightPaneFrame" BorderThickness="0" CornerRadius="8" Padding="2">
                                <StackPanel x:Name="RightContent" Spacing="12" />
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ForkLift-style Transfer HUD capsule (unified-look §2.4) -->
                <Border x:Name="TransferHud" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Margin="16,0,16,14" MaxWidth="440" CornerRadius="999"
                        Padding="18,12" Visibility="Collapsed"
                        Background="#CC2C2C2E"
                        BorderBrush="#14FFFFFF" BorderThickness="1"
                        Translation="0,0,32">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="HudIcon" Glyph="&#xE8C8;" FontSize="20"
                                  Foreground="{StaticResource FrAccentBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" MinWidth="160">
                            <TextBlock x:Name="HudHeadline" Text="Copying…" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource FrTextBrush}" />
                            <ProgressBar x:Name="HudProgress" Height="4" Minimum="0" Maximum="1" Value="0"
                                         Foreground="{StaticResource FrAccentBrush}" Background="#48484A" />
                        </StackPanel>
                        <TextBlock x:Name="HudPercent" Grid.Column="2" Text="0%" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" MinWidth="36" TextAlignment="Right"
                                   Foreground="{StaticResource FrMutedBrush}" FontFamily="Consolas" />
                        <Button x:Name="HudPauseBtn" Grid.Column="3" Content="Pause" Click="HudPause_Click"
                                Style="{StaticResource FrHudButton}" Foreground="{StaticResource FrTextBrush}" />
                        <Button x:Name="HudCancelBtn" Grid.Column="4" Content="Cancel" Click="HudCancel_Click"
                                Style="{StaticResource FrHudButton}" Foreground="{StaticResource FrTextBrush}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Rich inspector — Mac modular Info / Tags / More -->
            <Border x:Name="InspectorBorder" Grid.Column="2"
                    Background="{StaticResource FrPanelBrush}"
                    BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="1,0,0,0"
                    Padding="16,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer>
                        <StackPanel Spacing="14">
                            <Border x:Name="InspectorThumb" Height="200" CornerRadius="12"
                                    Background="{StaticResource FrPanel2Brush}"
                                    BorderBrush="{StaticResource FrBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Image x:Name="InspectorImage" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <FontIcon x:Name="InspectorGlyph" Glyph="&#xE8A5;" FontSize="44"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{StaticResource FrMutedBrush}" />
                                </Grid>
                            </Border>

                            <StackPanel Spacing="2">
                                <TextBlock x:Name="InspectorName" Text="Select a file"
                                           FontSize="16" FontWeight="SemiBold" TextWrapping="WrapWholeWords"
                                           Foreground="{StaticResource FrTextBrush}" />
                                <TextBlock x:Name="InspectorModified" Text="" FontSize="12"
                                           Foreground="{StaticResource FrMutedBrush}" />
                            </StackPanel>

                            <Expander Header="Info" IsExpanded="True" FontSize="13"
                                      Foreground="{StaticResource FrTextBrush}">
                                <StackPanel x:Name="InspectorMetaPanel" Spacing="8" Padding="0,8,0,0" />
                            </Expander>

                            <Expander Header="Tags" IsExpanded="True" FontSize="13"
                                      Foreground="{StaticResource FrTextBrush}">
                                <StackPanel Spacing="8" Padding="0,8,0,0">
                                    <StackPanel x:Name="InspectorTagsPanel" Orientation="Horizontal" Spacing="6" />
                                    <TextBlock x:Name="InspectorTagsEmpty" Text="No tags yet." FontSize="12"
                                               Foreground="{StaticResource FrMutedBrush}" Visibility="Collapsed" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="More" IsExpanded="False" FontSize="13"
                                      Foreground="{StaticResource FrTextBrush}">
                                <StackPanel x:Name="InspectorMorePanel" Spacing="6" Padding="0,8,0,0" />
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Spacing="8" Margin="0,12,0,0">
                        <Button x:Name="ShowInExplorerBtn" Click="ShowInExplorer_Click" HorizontalAlignment="Stretch"
                                Background="{StaticResource FrAccentBrush}" Foreground="White"
                                BorderThickness="0" CornerRadius="10" Padding="12,10" FontSize="13"
                                IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock Text="Show in Explorer" />
                            </StackPanel>
                        </Button>
                        <Button Content="Add to Drop Stack" Click="AddToDropStack_Click"
                                HorizontalAlignment="Stretch" Style="{StaticResource FrGhostButton}"
                                Background="Transparent" BorderBrush="{StaticResource FrBorderBrush}"
                                Foreground="{StaticResource FrMutedBrush}" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
