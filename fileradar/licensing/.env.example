# FileRadar licensing backend — example environment.
# Copy to .env (or export these variables) and fill in YOUR OWN values.
# This file contains NO real credentials, keys, or secrets — only names
# and placeholder shapes. Never commit a real .env file.
#
# How to load (from the licensing/ directory, if you use a shell):
#   set -a; source .env; set +a
# (Or export each variable manually. .env loading is NOT built into
#  the server; it reads the process environment only.)

# REQUIRED: launch date for the price schedule, YYYY-MM-DD.
# $8 for the first 60 days after this date, then $19. See pricing.py.
LAUNCH_DATE=YYYY-MM-DD

# Stripe — TEST MODE by default. Keep "1" until a deliberate production switch.
STRIPE_TEST_MODE=1
# Your Stripe TEST secret key (starts with sk_test_). Leave unset for
# mock-checkout local testing (no Stripe account needed, no money).
STRIPE_SECRET_KEY=
# Your Stripe TEST webhook signing secret (starts with whsec_).
STRIPE_WEBHOOK_SECRET=
# Where Checkout returns the buyer (the {CHECKOUT_SESSION_ID} token is
# substituted by Stripe; keep it in the success URL).
STRIPE_SUCCESS_URL=http://localhost:8000/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:8000/cancel

# Email — DRY RUN by default ("1" = log only, never send).
EMAIL_DRY_RUN=1
# Provider: "ionos" or "resend".
EMAIL_PROVIDER=ionos

# IONOS SMTP (only needed if EMAIL_PROVIDER=ionos and EMAIL_DRY_RUN=0).
IONOS_SMTP_USER=
IONOS_SMTP_PASS=
IONOS_FROM=

# Resend HTTP API (only needed if EMAIL_PROVIDER=resend and EMAIL_DRY_RUN=0).
RESEND_API_KEY=
RESEND_FROM=

# Server / storage.
LICENSING_HOST=127.0.0.1
LICENSING_PORT=8000
LICENSING_DB_PATH=licenses.db

# Admin — REQUIRED before any production exposure. Token for the
# /deactivate-serial admin endpoint (header X-Admin-Token or
# Authorization: Bearer). Long random value; never commit a real one.
# If unset, /deactivate-serial is DENIED (fail closed), never open.
LICENSING_ADMIN_TOKEN=

# TLS — set to "1" ONLY when a TLS reverse proxy / load balancer in
# front of this plain-HTTP server really terminates TLS for real
# traffic. Without it, and with test mode off or a non-loopback host,
# the server logs a loud warning and /health reports tls_warning=true.
LICENSING_TLS_TERMINATED=0
